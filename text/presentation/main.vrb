\frametitle{Cost of Braking}
\begin{verbatim}
% 40% return of energy due to regenerative braking
prev_wait(ID,T) :- action(train(ID),_,T),
                   time(T-1),
                   action(train(ID),wait,T-1).
energy(ID,T+1,E) :- action(train(ID),wait,T),
                    not prev_wait(ID,T),
                    cost_fac(ID,CF),
                    E = -1 * 100 * 4/10 * CF * 1/4 * 1/4.
\end{verbatim}
